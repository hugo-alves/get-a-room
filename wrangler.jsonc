{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "get-a-room",
  "main": "src/worker.ts",
  "assets": {
    "directory": "./public"
  },
  "compatibility_date": "2026-08-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "getaroom.run",
      "custom_domain": true
    },
    {
      "pattern": "www.getaroom.run",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://getaroom.run"
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ROOM_REQUEST_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false
    }
  }
}
