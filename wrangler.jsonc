{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "get-a-room",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false
    }
  }
}
