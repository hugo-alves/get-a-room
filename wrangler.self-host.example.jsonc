{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "get-a-room-self-hosted",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-05",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "PUBLIC_BASE_URL": "https://get-a-room-self-hosted.example.workers.dev"
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATION_RATE_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ROOM_REQUEST_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 180,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "replace-with-a-private-r2-bucket"
    }
  ],
  "exports": {
    "Room": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false
    }
  }
}
